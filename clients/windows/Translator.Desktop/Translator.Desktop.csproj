<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must match an installed Windows SDK; 10.0.26100.0 is present on this box. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged keeps `dotnet build` usable without MSIX signing tooling. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Translator.Desktop</RootNamespace>
    <AssemblyName>Translator.Desktop</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Path to the Rust core, relative to this project. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</RepoRoot>
    <CoreBinaryDebug>$(RepoRoot)target\debug\translator-core.exe</CoreBinaryDebug>
    <CoreBinaryRelease>$(RepoRoot)target\release\translator-core.exe</CoreBinaryRelease>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- C# message classes are generated by Grpc.Tools' bundled protoc. -->
  <ItemGroup>
    <Protobuf Include="$(RepoRoot)proto\translator.proto"
              ProtoRoot="$(RepoRoot)proto"
              GrpcServices="None" />
  </ItemGroup>

  <!--
    WinUI's XAML pre-compile runs a Roslyn pass over the whole project and fails
    if any type is unresolved. Grpc.Tools normally hooks `BeforeCompile`, which
    is too late, so force message generation ahead of the XAML passes.
  -->
  <Target Name="EnsureProtocolGenerated"
          BeforeTargets="MarkupCompilePass1"
          DependsOnTargets="_Protobuf_Compile_BeforeCsCompile" />

  <!-- Ship the core next to the client when it has already been built. -->
  <Target Name="CopyCoreBinary" AfterTargets="Build">
    <Copy SourceFiles="$(CoreBinaryDebug)" DestinationFolder="$(OutDir)core\"
          Condition="Exists('$(CoreBinaryDebug)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCoreBinaryRelease" AfterTargets="Build">
    <Copy SourceFiles="$(CoreBinaryRelease)" DestinationFolder="$(OutDir)core\"
          Condition="!Exists('$(CoreBinaryDebug)') And Exists('$(CoreBinaryRelease)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
