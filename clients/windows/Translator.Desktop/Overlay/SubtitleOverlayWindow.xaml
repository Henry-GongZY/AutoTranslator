<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Translator.Desktop.Overlay.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The HWND region is clipped to CaptionBorder after layout. The black
        surface outside the card is excluded even when compositor color-key
        transparency is unavailable.
    -->
    <Grid x:Name="Root" Background="#FF000000">
        <Border
            x:Name="CaptionBorder"
            Margin="0,0,0,28"
            Padding="24,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#FF202020"
            BorderBrush="#FF404040"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <TextBlock
                x:Name="CaptionText"
                MaxWidth="1040"
                FontSize="24"
                LineHeight="34"
                Foreground="#FFF5F5F5"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
