<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Translator.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="实时字幕">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </Grid.Resources>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="880" Margin="28,24,28,28" Spacing="16">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="实时字幕" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="让电脑里的声音，清晰可见。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE770;" FontSize="14" />
                            <TextBlock Text="系统音频" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                            <FontIcon x:Name="StatusIcon" Glyph="&#xE7F5;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusHint" Text="播放视频或音频，然后开始监听。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="StartButton" Click="OnStartClicked" Style="{StaticResource AccentButtonStyle}" Padding="20,10" AutomationProperties.Name="开始监听">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="开始监听" /></StackPanel>
                            </Button>
                            <Button x:Name="PauseButton" Click="OnPauseClicked" IsEnabled="False" Content="暂停" Padding="16,10" />
                            <Button x:Name="StopButton" Click="OnStopClicked" IsEnabled="False" Content="停止" Padding="16,10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="识别遇到问题" Message="请停止后重试；详细原因可在运行诊断中查看。" />

                <Border Style="{StaticResource Card}" MinHeight="176">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="当前字幕" FontWeight="SemiBold" />
                            <TextBlock x:Name="CaptionState" Text="等待监听" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="PreviewText" Grid.Row="1" Text="识别到的内容会显示在这里" FontSize="21" LineHeight="32" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="2" Text="字幕也会悬浮在屏幕底部，方便边看边读。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18" /><TextBlock Text="识别与字幕设置" FontWeight="SemiBold" /></StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="20">
                        <TextBlock Text="识别设置在下次开始监听时生效。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProviderBox" Header="识别服务" SelectionChanged="OnRecognitionChanged" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="本地 · Whisper" Tag="whisper" />
                                <ComboBoxItem Content="演示模式 · Mock" Tag="mock" />
                                <ComboBoxItem Content="远端识别 API · 尚未接入" IsEnabled="False" />
                            </ComboBox>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Header="音频语言" SelectionChanged="OnLanguageChanged" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="自动检测" Tag="" /><ComboBoxItem Content="中文" Tag="zh" /><ComboBoxItem Content="英文" Tag="en" /><ComboBoxItem Content="日文" Tag="ja" /><ComboBoxItem Content="韩文" Tag="ko" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="WhisperSettings" Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="EngineBox" Header="Whisper 引擎" HorizontalAlignment="Stretch" SelectionChanged="OnRecognitionChanged" SelectedIndex="3">
                                    <ComboBoxItem Content="whisper.cpp CPU" Tag="cpu" />
                                    <ComboBoxItem Content="whisper.cpp BLAS" Tag="blas" />
                                    <ComboBoxItem Content="whisper.cpp Vulkan" Tag="vulkan" />
                                    <ComboBoxItem Content="whisper.cpp CUDA" Tag="cuda" />
                                </ComboBox>
                                <ComboBox x:Name="ModelBox" MaxDropDownHeight="320" Grid.Column="1" Header="Whisper 模型" HorizontalAlignment="Stretch" SelectionChanged="OnRecognitionChanged" />
                            </Grid>
                            <TextBlock x:Name="EngineHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ModelDirectoryBox" Header="模型文件夹" LostFocus="OnModelDirectoryCommitted" PlaceholderText="选择保存模型的文件夹" />
                                <Button x:Name="BrowseModelDirectory" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="OnBrowseModelDirectory" />
                                <Button Grid.Column="2" Content="打开" VerticalAlignment="Bottom" Click="OnOpenModelDirectory" />
                            </Grid>
                            <ProgressBar x:Name="ModelProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ModelStatus" Text="选择模型后自动检查，缺失时下载。" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                                <Button x:Name="RetryModelButton" Grid.Column="1" Content="重试下载" Visibility="Collapsed" Click="OnRetryModel" />
                                <Button x:Name="CancelModelButton" Grid.Column="2" Content="取消下载" Visibility="Collapsed" Click="OnCancelModel" />
                            </Grid>
                            <TextBlock Text="四种引擎共用模型文件。BLAS 使用 CPU 加速；Vulkan 支持多厂商 GPU；CUDA 适用于 NVIDIA GPU。模型越大，通常越准确，也需要更多内存和识别时间。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="MaxLinesBox" Header="最多显示行数" Minimum="1" Maximum="4" Value="2" SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Name="MaxCharsBox" Grid.Column="1" Header="每行字符数" Minimum="10" Maximum="120" Value="42" SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <CheckBox x:Name="ClickThroughBox" Content="鼠标穿透字幕，不影响下方操作" IsChecked="True" Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged" />
                        <TextBlock Text="本地识别无需上传音频。选择模型后，缺失文件会自动下载至指定文件夹；演示模式仅显示模拟字幕。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="18" /><TextBlock Text="运行诊断" /></StackPanel></Expander.Header>
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="MetricsText" Text="开始监听后显示音频统计。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DiagnosticText" Text="暂无运行信息。" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
