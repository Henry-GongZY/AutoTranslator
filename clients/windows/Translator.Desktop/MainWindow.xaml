<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Translator.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="实时字幕 · 控制台">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Text="实时字幕（阶段一）" />

            <Border
                Padding="16"
                BorderBrush="#FF3A3A3A"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StatusText" Text="未启动" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartButton" Click="OnStartClicked" Content="开始监听" />
                        <Button x:Name="StopButton" Click="OnStopClicked" Content="停止" IsEnabled="False" />
                        <ToggleSwitch
                            x:Name="PauseSwitch"
                            Header="暂停识别"
                            IsEnabled="False"
                            IsOn="False"
                            Toggled="OnPauseToggled" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <ComboBox
                            x:Name="ProviderBox"
                            Header="识别引擎"
                            SelectedIndex="0"
                            Width="200">
                            <ComboBoxItem Content="本地 Whisper (tiny)" Tag="whisper" />
                            <ComboBoxItem Content="Mock（演示）" Tag="mock" />
                        </ComboBox>
                        <ComboBox
                            x:Name="LanguageBox"
                            Header="语言"
                            SelectedIndex="0"
                            Width="160">
                            <ComboBoxItem Content="自动检测" Tag="" />
                            <ComboBoxItem Content="中文" Tag="zh" />
                            <ComboBoxItem Content="英文" Tag="en" />
                            <ComboBoxItem Content="日文" Tag="ja" />
                            <ComboBoxItem Content="韩文" Tag="ko" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                BorderBrush="#FF3A3A3A"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <NumberBox
                        x:Name="MaxLinesBox"
                        Header="显示行数"
                        Maximum="4"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="2" />
                    <NumberBox
                        x:Name="MaxCharsBox"
                        Header="每行字符数"
                        Maximum="120"
                        Minimum="10"
                        SpinButtonPlacementMode="Compact"
                        Value="42" />
                    <CheckBox
                        x:Name="ClickThroughBox"
                        Checked="OnClickThroughChanged"
                        Content="字幕点击穿透"
                        IsChecked="True"
                        Unchecked="OnClickThroughChanged" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="MetricsText" Opacity="0.75" TextWrapping="Wrap" />

            <TextBlock
                Opacity="0.75"
                Text="阶段一说明：捕获系统内录音频 → Rust core 做 VAD 与识别 → 字幕悬浮窗显示。选择「本地 Whisper」可离线识别（首次需从镜像下载 tiny 模型，约 77MB）。Mock 为演示用假识别。"
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Window>
